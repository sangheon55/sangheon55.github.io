---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, tech, github, demo } = entry.data;
---

<Base title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="muted">{description}</p>
    <div class="item-meta small">
      <span>{date.getFullYear()}</span>
      <span>{tech.map((t) => <span class="tag">{t}</span>)}</span>
      {github && <a href={github}>GitHub</a>}
      {demo && <a href={demo}>Demo</a>}
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="small"><a href="/projects/">← 프로젝트 목록</a></p>
</Base>
